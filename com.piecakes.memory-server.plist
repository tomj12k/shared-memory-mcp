<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.piecakes.memory-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/piecakes/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/piecakes/memory-server</string>
        <string>memory-server</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/piecakes/memory-server</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MEMORIES_DIR</key>
        <string>/Users/piecakes/memories</string>
